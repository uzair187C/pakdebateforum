{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pakdebateforumn-worker",
	"main": "src/index.js",
	"compatibility_date": "2025-12-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"routes": [
		{ "pattern": "pakdebateforum.com/*", "zone_name": "pakdebateforum.com" },
		{ "pattern": "www.pakdebateforum.com/*", "zone_name": "pakdebateforum.com" }
	],
	"assets": {
		"directory": "../public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pakdebate-db",
			"database_id": "04bedff1-fec6-424a-a66b-a6913aa1885f"
		}
	],
	"vars": {
		"ADMIN_KEY": "local-admin-2024"
	},
	"observability": {
		"enabled": true
	}
}